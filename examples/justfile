# Deploy recipes behind may-i. Which vault is which lives in your own
# ~/.config/may-i/config.json, not in the repo:
#
#     { "allow": ["op://Staging/*"] }
#
# Staging references are allowed, so staging recipes run at once, with the
# staging service-account token already in your environment. Everything else
# asks, and only an Approve hands that one command the prod token.
#
# Each recipe has an env file of its own, naming only what its script reads, so
# the approval lists exactly those fields. `just check-env-files` holds them to it.

# Staging: allowed, so it runs straight away and is still recorded.
deploy-staging:
    may-i -- op run --env-file .env.deploy-staging -- ./deploy.sh staging

# Prod: asks first. The reason is shown in the prompt and kept in the receipt.
deploy-prod reason="ship main to production":
    may-i --reason {{ quote(reason) }} -- op run --env-file .env.deploy-prod -- ./deploy.sh production

# The kind of recipe an agent adds: it needs prod credentials, so it starts with
# may-i, and gets an env file of its own.
db-migrate-prod:
    may-i --reason "apply pending database migrations to production" -- op run --env-file .env.db-migrate-prod -- ./scripts/migrate.sh

# Run in pre-commit (see ./pre-commit) and in CI.
check-env-files:
    bun check-env-files.ts
