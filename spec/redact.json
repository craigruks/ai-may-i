    {
      "name": "masks assignments, bearer tokens, URL passwords and secret flags inside bash -c",
      "argv": [
        "bash",
        "-c",
        "TOKEN=abc123 curl -H \"Authorization: Bearer abc.def\" https://u:pw@host/x --password hunter2"
      ],
      "shown": "bash -c 'TOKEN=*** curl -H \"Authorization: Bearer ***\" https://u:***@host/x --password ***'"
    },
    {
      "name": "leaves paths, file names, hashes and ordinary flags readable",
