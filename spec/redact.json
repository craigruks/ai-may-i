{
  "redactCommand": [
    {
      "name": "keeps a reference, which is a name and not a secret",
      "argv": ["op", "read", "op://Prod/db/password"],
      "shown": "op read op://Prod/db/password"
    },
    {
      "name": "masks a secret flag's inline value",
      "argv": ["tool", "--password=hunter2"],
      "shown": "tool --password=***"
    },
    {
      "name": "masks a secret flag's value given as the next word",
      "argv": ["tool", "--api-token", "t0ps3cret", "--name", "x"],
      "shown": "tool --api-token *** --name x"
    },
    {
      "name": "masks any NAME=value",
      "argv": ["env", "TOKEN=hunter2", "make"],
      "shown": "env TOKEN=*** make"
    },
    {
      "name": "keeps NAME=reference",
      "argv": ["env", "API_KEY=op://Prod/api/key", "make"],
      "shown": "env API_KEY=op://Prod/api/key make"
    },
    {
      "name": "masks a long token-shaped word",
      "argv": ["deploy", "ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"],
      "shown": "deploy ***"
    },
    {
      "name": "masks base64 with a slash in it",
      "argv": ["curl", "-d", "dGhpcyBpcyBhIHNlY3JldCB2YWx1ZS/0aGF0IGlzIGxvbmc9"],
      "shown": "curl -d ***"
    },
    {
      "name": "masks a JWT",
